# Ruta relativa o absoluta al archivo de credenciales de Google Service Account
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ID de la carpeta contenedora en Google Drive (ej. Asesorias o Asesorias_2026)
GOOGLE_DRIVE_FOLDER_ID=tu_folder_id_aqui

# API Key para Google Gemini (Google AI Studio)
GEMINI_API_KEY=tu_gemini_api_key_aqui
